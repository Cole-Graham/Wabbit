{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Teams Schema",
    "description": "Schema for stored team configurations",
    "type": "object",
    "properties": {
        "teams": {
            "type": "array",
            "description": "List of registered teams",
            "items": {
                "type": "object",
                "properties": {
                    "teamId": {
                        "type": "string",
                        "description": "Unique identifier for the team"
                    },
                    "teamName": {
                        "type": "string",
                        "description": "The team's name (must be unique)"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "OneVOne",
                            "TwoVTwo",
                            "ThreeVThree",
                            "FourVFour"
                        ],
                        "description": "The type of team"
                    },
                    "rating": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "The team's current ELO rating (starting at 1200)"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time",
                        "description": "When the team was created"
                    },
                    "lastNameChangeDate": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time",
                        "description": "When the team name was last changed"
                    },
                    "lastSecondaryChangeDate": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time",
                        "description": "When secondary players were last changed"
                    },
                    "lastSubstituteChangeDate": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "format": "date-time",
                        "description": "When substitute players were last changed"
                    },
                    "wins": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "Number of wins"
                    },
                    "losses": {
                        "type": "integer",
                        "minimum": 0,
                        "description": "Number of losses"
                    },
                    "corePlayerInfo": {
                        "type": "array",
                        "description": "IDs of core players",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "string",
                                    "description": "Discord User ID"
                                },
                                "username": {
                                    "type": "string",
                                    "description": "Discord Username"
                                }
                            },
                            "required": [
                                "id",
                                "username"
                            ]
                        }
                    },
                    "secondaryPlayerInfo": {
                        "type": "array",
                        "description": "IDs of secondary players",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "string",
                                    "description": "Discord User ID"
                                },
                                "username": {
                                    "type": "string",
                                    "description": "Discord Username"
                                }
                            },
                            "required": [
                                "id",
                                "username"
                            ]
                        }
                    },
                    "substitutePlayerInfo": {
                        "type": "array",
                        "description": "IDs of substitute players",
                        "items": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "string",
                                    "description": "Discord User ID"
                                },
                                "username": {
                                    "type": "string",
                                    "description": "Discord Username"
                                }
                            },
                            "required": [
                                "id",
                                "username"
                            ]
                        }
                    },
                    "creatorId": {
                        "type": "string",
                        "description": "Discord User ID of the creator"
                    },
                    "creatorUsername": {
                        "type": "string",
                        "description": "Username of the creator"
                    },
                    "ratingHistory": {
                        "type": "array",
                        "description": "History of rating changes",
                        "items": {
                            "type": "object",
                            "properties": {
                                "oldRating": {
                                    "type": "integer",
                                    "description": "Rating before the change"
                                },
                                "newRating": {
                                    "type": "integer",
                                    "description": "Rating after the change"
                                },
                                "change": {
                                    "type": "integer",
                                    "description": "The amount of change (positive or negative)"
                                },
                                "opponent": {
                                    "type": "string",
                                    "description": "Name of the opponent"
                                },
                                "isWin": {
                                    "type": "boolean",
                                    "description": "Whether this was a win"
                                },
                                "date": {
                                    "type": "string",
                                    "format": "date-time",
                                    "description": "When the rating change occurred"
                                }
                            },
                            "required": [
                                "oldRating",
                                "newRating",
                                "change",
                                "opponent",
                                "isWin",
                                "date"
                            ]
                        }
                    }
                },
                "required": [
                    "teamId",
                    "teamName",
                    "type",
                    "rating",
                    "createdAt",
                    "wins",
                    "losses",
                    "corePlayerInfo",
                    "creatorId",
                    "creatorUsername"
                ]
            }
        }
    },
    "required": [
        "teams"
    ]
}