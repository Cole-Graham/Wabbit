{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Ratings Schema",
    "description": "Schema for player 1v1 ratings - PlayerRating only tracks 1v1 ratings; team-based formats use Team ratings",
    "type": "object",
    "properties": {
        "players": {
            "type": "array",
            "description": "List of player 1v1 ratings",
            "items": {
                "type": "object",
                "properties": {
                    "playerId": {
                        "type": "string",
                        "description": "Discord User ID of the player"
                    },
                    "username": {
                        "type": "string",
                        "description": "Username of the player"
                    },
                    "rating": {
                        "type": "integer",
                        "description": "The player's 1v1 rating (starting at 1200)"
                    },
                    "tournamentRating": {
                        "type": "integer",
                        "description": "The player's tournament 1v1 rating (starting at 1200)"
                    },
                    "wins": {
                        "type": "integer",
                        "description": "Number of 1v1 wins"
                    },
                    "losses": {
                        "type": "integer",
                        "description": "Number of 1v1 losses"
                    },
                    "ratingHistory": {
                        "type": "array",
                        "description": "History of rating changes",
                        "items": {
                            "$ref": "#/definitions/ratingChange"
                        }
                    }
                },
                "required": [
                    "playerId",
                    "username",
                    "rating",
                    "tournamentRating",
                    "wins",
                    "losses"
                ]
            }
        }
    },
    "definitions": {
        "ratingChange": {
            "type": "object",
            "properties": {
                "oldRating": {
                    "type": "integer",
                    "description": "Rating before the change"
                },
                "newRating": {
                    "type": "integer",
                    "description": "Rating after the change"
                },
                "change": {
                    "type": "integer",
                    "description": "The amount of change (positive or negative)"
                },
                "opponent": {
                    "type": "string",
                    "description": "Name of the opponent"
                },
                "teamName": {
                    "type": "string",
                    "description": "Name of the team (if applicable)"
                },
                "isTournamentMatch": {
                    "type": "boolean",
                    "description": "Whether this was a tournament match"
                },
                "tournamentName": {
                    "type": "string",
                    "description": "Name of the tournament (if applicable)"
                },
                "isWin": {
                    "type": "boolean",
                    "description": "Whether this was a win"
                },
                "date": {
                    "type": "string",
                    "format": "date-time",
                    "description": "When the rating change occurred"
                }
            },
            "required": [
                "oldRating",
                "newRating",
                "change",
                "opponent",
                "isWin",
                "date"
            ]
        }
    },
    "required": [
        "players"
    ]
}