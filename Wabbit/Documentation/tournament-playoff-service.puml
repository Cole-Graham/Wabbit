@startuml Tournament Service Architecture

' Set vertical direction and layout optimization
top to bottom direction
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 60
' Reduce width
skinparam classAttributeIconSize 0
skinparam maxMessageSize 100
skinparam wrapWidth 200

skinparam class {
    BackgroundColor White
    ArrowColor #333
    BorderColor #333
    ' Add padding to reduce horizontal width
    Padding 5
    ' Style to make the diagram more compact
    Style strictuml
}

' Custom styling for service layers
skinparam package {
    BackgroundColor transparent
    BorderColor gray
    FontColor gray
    FontSize 11
}

' Add Model Package
package "Models" as ModelLayer {
    ' Main tournament model
    class Tournament {
        +Name: string
        +Groups: List<Group>
        +PlayoffMatches: List<Match>
        +CurrentStage: TournamentStage
        +Format: TournamentFormat
        +GameType: GameType
        +IsComplete: bool
        +Winner: object
        +Settings: TournamentSettings
        +CustomProperties: Dictionary<string, object>
        +RelatedMessages: List<RelatedMessage>
    }
    
    ' Tournament group model
    class Group {
        +Name: string
        +Participants: List<GroupParticipant>
        +Matches: List<Match>
        +IsComplete: bool
        +Tournament: Tournament
    }
    
    ' Group participant model
    class GroupParticipant {
        +Player: object
        +Wins: int
        +Draws: int
        +Losses: int
        +Points: int
        +AdvancedToPlayoffs: bool
        +Seed: int
        +GamesWon: int
        +GamesLost: int
        +SourceGroup: Group
        +QualificationInfo: string
    }
    
    ' Match model
    class Match {
        +Id: string
        +Name: string
        +Type: TournamentMatchType
        +Participants: List<MatchParticipant>
        +Result: MatchResult
        +LinkedRound: Round
        +NextMatch: Match
        +ThirdPlaceMatch: Match
        +BestOf: int
        +IsComplete: bool
        +IsTiebreakerMatch: bool
    }
    
    ' Match participant model
    class MatchParticipant {
        +Player: object
        +SourceGroup: Group
        +SourceMatch: Match
        +SourceGroupPosition: int
        +Score: int
    }
    
    ' Match result model
    class MatchResult {
        +Winner: object
        +WinnerScore: int
        +LoserScore: int
        +MapResults: List<string>
        +CompletedAt: DateTime
        +Status: MatchStatus
        +ResultType: MatchResultType
        +Forfeiter: object
        +DeckCodes: Dictionary
    }
    
    ' Tournament signup model
    class TournamentSignup {
        +Name: string
        +IsOpen: bool
        +CreatedAt: DateTime
        +Participants: List<DiscordMember>
        +Seeds: List<ParticipantSeed>
        +Format: TournamentFormat
        +Type: GameType
        +ScheduledStartTime: DateTime?
        +SignupChannelId: ulong
        +MessageId: ulong
        +RelatedMessages: List<RelatedMessage>
    }
    
    ' Participant seed model
    class ParticipantSeed {
        +Player: DiscordMember
        +Seed: int
    }
    
    ' Related message model
    class RelatedMessage {
        +ChannelId: ulong
        +MessageId: ulong
        +Type: string
    }
    
    ' Round model (for match execution)
    class Round {
        +Name: string
        +Teams: List<Team>
        +Maps: List<string>
        +TournamentId: string
        +CurrentStage: MatchStage
        +IsCompleted: bool
        +StatusMessageId: ulong?
        +CustomProperties: Dictionary<string, object>
    }
    
    ' Team model (for a round)
    class Team {
        +Name: string
        +Thread: DiscordThreadChannel
        +Participants: List<Participant>
        +Wins: int
        +MapBans: List<string>
        +HasSubmittedDeck: bool
    }
    
    ' Participant model (for a team)
    class Participant {
        +Player: DiscordMember
        +Deck: string
        +TempDeckCode: string
        +DeckHistory: Dictionary<string, string>
    }
    
    ' Map model
    class Map {
        +Name: string
        +Id: string
        +Thumbnail: string
        +IsInTournamentPool: bool
    }
    
    ' Tournament settings model
    class TournamentSettings {
        +MinPlayers: int
        +MaxPlayers: int
        +IncludeThirdPlaceMatch: bool
        +BestOfFinals: int
        +BestOfSemifinals: int
        +BestOfQuarterfinals: int
        +BestOfGroupStage: int
    }
    
    ' Enums
    enum TournamentStage {
        SignupOpen
        Groups
        Playoffs
        Complete
    }
    
    enum TournamentFormat {
        GroupStageWithPlayoffs
        SingleElimination
        DoubleElimination
        RoundRobin
    }
    
    enum GameType {
        OneVsOne
        TwoVsTwo
    }
    
    enum TournamentMatchType {
        GroupStage
        GroupStageTiebreaker
        RoundOf16
        Quarterfinal
        Semifinal
        Final
        PlayoffThirdPlace
    }
    
    enum MatchStatus {
        Pending
        InProgress
        Completed
        Cancelled
    }
    
    enum MatchResultType {
        Normal
        Forfeit
        Disqualification
        Tiebreaker
        Default
    }
    
    enum MatchStage {
        Created
        MapBan
        DeckSubmission
        DeckRevision
        GameResults
        Completed
    }
    
    ' Model relationships
    Tournament *-- "0..*" Group
    Tournament *-- "0..*" Match
    Tournament *-- "1" TournamentSettings
    
    Group *-- "0..*" GroupParticipant
    Group *-- "0..*" Match
    Group --o "1" Tournament
    
    Match *-- "0..*" MatchParticipant
    Match *-- "0..1" MatchResult
    Match --o "0..1" Match : NextMatch
    Match --o "0..1" Match : ThirdPlaceMatch
    Match --o "0..1" Round
    
    MatchParticipant --o "0..1" Group
    MatchParticipant --o "0..1" Match
    
    Round *-- "0..*" Team
    Team *-- "0..*" Participant
    
    TournamentSignup *-- "0..*" ParticipantSeed
    TournamentSignup *-- "0..*" RelatedMessage
}

' Define new package for Event Handling System
package "Event Handling System" as EventLayer {
    ' Main event handlers
    class ComponentInteractionHandler <<event handler>> {
        -_factory: ComponentHandlerFactory
        -_logger: ILogger
        +HandleEventAsync(sender: DiscordClient, e: ComponentInteractionCreatedEventArgs)
    }

    class ModalInteractionHandler <<event handler>> {
        -_factory: ModalHandlerFactory
        -_logger: ILogger
        +HandleEventAsync(sender: DiscordClient, e: ModalSubmitEventArgs)
    }

    ' Component handlers
    class TournamentSignupHandler <<component handler>> {
        -_signupService: ITournamentSignupService
        -_tournamentService: ITournamentService
        +CanHandle(customId: string): bool
        +HandleAsync(client: DiscordClient, e: ComponentInteractionCreatedEventArgs, hasBeenDeferred: bool): Task
        -HandleSignupButton()
        -HandleWithdrawButton()
        -HandleCancelSignupButton()
    }

    class MapBanHandler <<component handler>> {
        -_matchStatusService: IMatchStatusService
        -_mapService: ITournamentMapService
        +CanHandle(customId: string): bool
        +HandleAsync(client: DiscordClient, e: ComponentInteractionCreatedEventArgs, hasBeenDeferred: bool): Task
    }

    class GameResultHandler <<component handler>> {
        -_gameService: ITournamentGameService
        +CanHandle(customId: string): bool
        +HandleAsync(client: DiscordClient, e: ComponentInteractionCreatedEventArgs, hasBeenDeferred: bool): Task
    }

    class DeckSubmissionHandler <<component handler>> {
        -_matchStatusService: IMatchStatusService
        +CanHandle(customId: string): bool
        +HandleAsync(client: DiscordClient, e: ComponentInteractionCreatedEventArgs, hasBeenDeferred: bool): Task
    }

    ' Modal handlers
    class MapBanModalHandler <<modal handler>> {
        -_matchStatusService: IMatchStatusService
        -_mapService: ITournamentMapService
        +CanHandle(customId: string): bool
        +HandleAsync(client: DiscordClient, e: ModalSubmitEventArgs, hasBeenDeferred: bool): Task
    }

    class DeckSubmissionModalHandler <<modal handler>> {
        -_matchStatusService: IMatchStatusService
        +CanHandle(customId: string): bool
        +HandleAsync(client: DiscordClient, e: ModalSubmitEventArgs, hasBeenDeferred: bool): Task
    }

    class TournamentCreationModalHandler <<modal handler>> {
        -_tournamentService: ITournamentService
        -_managerService: ITournamentManagerService
        +CanHandle(customId: string): bool
        +HandleAsync(client: DiscordClient, e: ModalSubmitEventArgs, hasBeenDeferred: bool): Task
    }

    ' Factories
    class ComponentHandlerFactory <<factory>> {
        -_serviceProvider: IServiceProvider
        -_logger: ILogger
        +CreateHandler(customId: string): ComponentHandlerBase
    }

    class ModalHandlerFactory <<factory>> {
        -_serviceProvider: IServiceProvider
        -_logger: ILogger
        +CreateHandler(customId: string): ModalHandlerBase
    }

    ' Base abstract classes
    abstract class ComponentHandlerBase {
        #_logger: ILogger
        #_stateService: ITournamentStateService
        +{abstract} CanHandle(customId: string): bool
        +{abstract} HandleAsync(client: DiscordClient, e: ComponentInteractionCreatedEventArgs, hasBeenDeferred: bool): Task
    }

    abstract class ModalHandlerBase {
        #_logger: ILogger
        #_stateService: ITournamentStateService
        +{abstract} CanHandle(customId: string): bool
        +{abstract} HandleAsync(client: DiscordClient, e: ModalSubmitEventArgs, hasBeenDeferred: bool): Task
    }
}

' Define service layers as packages
package "Command/UI Layer" as UILayer {
    class TournamentManagementGroup <<command handler>> {
        +CreateSignup() <<"/tournament signup_create">>
        +CreateTournamentFromSignup()
        +StartMatchRoundAsync()
        +AddToSignup()/RemoveFromSignup()
        +SetSeed()
    }
    
    class AdminThirdPlaceMatchHandler <<component handler>> {
        +HandleAdminThirdPlaceMatchAsync()
    }
    
    class "Map/Game Handlers" as GameHandlers <<component handler>> {
        +MapBanHandler
        +GameResultHandler
    }
    
    note right of TournamentManagementGroup::CreateSignup
      /tournament signup_create <name> <format> <gameType> <startTimeUnix>
      Creates tournament signup with specified parameters
    end note
}

package "Service Coordinator Layer" as CoordinatorLayer {
    class TournamentService {
        +GetTournamentAsync()
        +SaveTournamentAsync()
        +CreateTournamentAsync()
    }
    
    class TournamentManagerService {
        +CreateTournamentAsync()
        +StartTournamentAsync()
        +FinalizeTournamentAsync()
    }
    
    class TournamentSignupService {
        +CreateSignup()
        +UpdateSignup()
        +SaveSignupsAsync()
        +CreateSignupEmbed()
    }
    
    class TournamentRepositoryService {
        +SaveTournamentAsync()
        +LoadTournamentsAsync()
        +CleanPlayerForSerialization()
        +ArchiveTournamentAsync()
    }
}

package "Core Services Layer" as CoreLayer {
    ' Core service interface
    interface ITournamentPlayoffService {
        +SetupPlayoffsAsync()
        +StartPlayoffMatchesAsync()
        +UpdateBracketAdvancementAsync()
        +ProcessForfeitAsync()
        +AreSemifinalsCompleted()
        +CanCreateThirdPlaceMatch()
        +CreateThirdPlaceMatchAsync()
    }
    
    ' Implementation
    class TournamentPlayoffService {
        -_logger
        -_matchOperations
        -_stateValidator
        -_bracketManager
        +SetupPlayoffs()
        +UpdateBracketAdvancement()
        -HandleThirdPlaceAdvancement()
        -CreateThirdPlaceMatch()
        -GetQualifiedParticipants()
        -SeedParticipants()
    }
    
    class TournamentMatchService {
        +CreateMatchAsync()
        +UpdateMatchResultAsync()
        +StartMatchRoundAsync()
    }
    
    class TournamentGroupService {
        +CreateGroups()
        +DetermineGroupCount()
        +GetOptimalGroupSizes()
        +DistributePlayersWithSeeding()
    }
    
    class MatchStatusService {
        +UpdateToMapBanStageAsync()
        +UpdateToDeckSubmissionStageAsync()
        +RecordMapBanAsync()
        +UpdateMatchStatusAsync()
    }
    
    class TournamentStateService {
        +SaveTournamentStateAsync()
        +LoadTournamentStateAsync()
        +UpdateTournamentStateAsync()
        +TrackMatchProgress()
    }

    class TournamentMapService {
        +GetMapPoolAsync()
        +ValidateMapBansAsync()
        +GetMapSelectionOptionsAsync()
    }

    class TournamentGameService {
        +HandleGameResultAsync()
        +ProcessWinnerSelectionAsync()
        +IsMatchCompleteAsync()
    }
}

package "Base Services Layer" as BaseLayer {
    ' Helper interfaces arranged vertically
    interface ITournamentMatchOperationsService {
        +CreateMatch()
        +UpdateMatchResultAsync()
    }
    
    interface ITournamentStateValidator {
        +IsValidStateTransition()
        +ValidatePlayoffSetup()
        +ValidatePlayoffBracket()
    }
    
    interface ITournamentBracketManager {
        +UpdateBracketAdvancement()
        +CreatePlayoffBracket()
        +LinkBracketMatches()
    }
    
    interface ITournamentScoreManager {
        +UpdateGroupScores()
        +CalculateStandings()
    }
    
    interface IMatchStatusService {
        +UpdateToMapBanStageAsync()
        +UpdateToDeckSubmissionStageAsync()
        +RecordMapBanAsync()
    }
    
    interface ITournamentStateService {
        +SaveTournamentStateAsync()
        +LoadTournamentStateAsync()
        +UpdateTournamentStateAsync()
    }
    
    interface ITournamentRepositoryService {
        +SaveTournamentAsync()
        +LoadTournamentsAsync()
        +ArchiveTournamentAsync()
    }

    interface ITournamentMapService {
        +GetMapPoolAsync()
        +ValidateMapBansAsync()
        +GetMapSelectionOptionsAsync()
    }

    interface ITournamentGameService {
        +HandleGameResultAsync()
        +ProcessWinnerSelectionAsync()
        +IsMatchCompleteAsync()
    }
    
    ' Implementation classes for base services
    class TournamentMatchOperationsService {
    }
    
    class TournamentStateValidator {
    }
    
    class TournamentBracketManager {
    }
    
    class TournamentScoreManager {
    }
}

