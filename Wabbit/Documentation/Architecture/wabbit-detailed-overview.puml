@startuml Tournament Service Architecture

' Set vertical direction and layout optimization
top to bottom direction
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 60
' Reduce width
skinparam classAttributeIconSize 0
skinparam maxMessageSize 100
skinparam wrapWidth 200

skinparam class {
    BackgroundColor White
    ArrowColor #333
    BorderColor #333
    ' Add padding to reduce horizontal width
    Padding 5
    ' Style to make the diagram more compact
    Style strictuml
}

' Custom styling for service layers
skinparam package {
    BackgroundColor transparent
    BorderColor gray
    FontColor gray
    FontSize 11
}

' Add Model Package
package "Models" as ModelLayer {
    ' Main tournament model
    class Tournament {
        +Name: string
        +Groups: List<Group>
        +PlayoffMatches: List<Match>
        +CurrentStage: TournamentStage
        +Format: TournamentFormat
        +GameType: GameType
        +IsComplete: bool
        +Winner: object
        +Settings: TournamentSettings
        +CustomProperties: Dictionary<string, object>
        +RelatedMessages: List<RelatedMessage>
        +AnnouncementChannel: DiscordChannel
    }
    
    ' Tournament group model
    class Group {
        +Name: string
        +Participants: List<GroupParticipant>
        +Matches: List<Match>
        +IsComplete: bool
        +Tournament: Tournament
    }
    
    ' Group participant model
    class GroupParticipant {
        +Player: object
        +Wins: int
        +Draws: int
        +Losses: int
        +Points: int
        +AdvancedToPlayoffs: bool
        +Seed: int
        +GamesWon: int
        +GamesLost: int
        +SourceGroup: Group
        +QualificationInfo: string
    }
    
    ' Match model
    class Match {
        +Id: string
        +Name: string
        +Type: TournamentMatchType
        +Participants: List<MatchParticipant>
        +Result: MatchResult
        +LinkedRound: Round
        +NextMatch: Match
        +ThirdPlaceMatch: Match
        +BestOf: int
        +IsComplete: bool
        +IsTiebreakerMatch: bool
    }
    
    ' Match participant model
    class MatchParticipant {
        +Player: object
        +SourceGroup: Group
        +SourceMatch: Match
        +SourceGroupPosition: int
        +Score: int
    }
    
    ' Match result model
    class MatchResult {
        +Winner: object
        +WinnerScore: int
        +LoserScore: int
        +MapResults: List<string>
        +CompletedAt: DateTime
        +Status: MatchStatus
        +ResultType: MatchResultType
        +Forfeiter: object
        +DeckCodes: Dictionary
    }
    
    ' Tournament signup model
    class TournamentSignup {
        +Name: string
        +IsOpen: bool
        +CreatedAt: DateTime
        +Participants: List<DiscordMember>
        +Seeds: List<ParticipantSeed>
        +Format: TournamentFormat
        +Type: GameType
        +ScheduledStartTime: DateTime?
        +SignupChannelId: ulong
        +MessageId: ulong
        +RelatedMessages: List<RelatedMessage>
    }
    
    ' Participant seed model
    class ParticipantSeed {
        +Player: DiscordMember
        +Seed: int
    }
    
    ' Related message model
    class RelatedMessage {
        +ChannelId: ulong
        +MessageId: ulong
        +Type: string
    }
    
    ' Round model (for match execution)
    class Round {
        +Name: string
        +Teams: List<Team>
        +Maps: List<string>
        +TournamentId: string
        +CurrentStage: MatchStage
        +IsCompleted: bool
        +StatusMessageId: ulong?
        +CustomProperties: Dictionary<string, object>
    }
    
    ' Team model (for a round)
    class Team {
        +Name: string
        +Thread: DiscordThreadChannel
        +Participants: List<Participant>
        +Wins: int
        +MapBans: List<string>
        +HasSubmittedDeck: bool
    }
    
    ' Participant model (for a team)
    class Participant {
        +Player: DiscordMember
        +Deck: string
        +TempDeckCode: string
        +DeckHistory: Dictionary<string, string>
    }
    
    ' Map model
    class Map {
        +Name: string
        +Id: string
        +Thumbnail: string
        +IsInTournamentPool: bool
    }
    
    ' Tournament settings model
    class TournamentSettings {
        +MinPlayers: int
        +MaxPlayers: int
        +IncludeThirdPlaceMatch: bool
        +BestOfFinals: int
        +BestOfSemifinals: int
        +BestOfQuarterfinals: int
        +BestOfGroupStage: int
    }
    
    ' New Rating Models
    class Season {
        +SeasonId: string
        +SeasonName: string
        +Description: string
        +StartDate: DateTimeOffset
        +EndDate: DateTimeOffset?
        +IsActive: bool
        +CreatorId: ulong
        +CreatorUsername: string
        +FinalRankings: Dictionary<TeamGameType, List<SeasonRanking>>
        +Messages: List<SeasonMessage>
        +AddMessage()
        +AddRelatedMessage()
        +EndSeason()
        +GetFormattedDuration()
    }
    
    class SeasonRanking {
        +Rank: int
        +IsTeam: bool
        +PlayerId: ulong
        +PlayerUsername: string?
        +TeamId: string?
        +TeamName: string?
        +Rating: int
        +Wins: int
        +Losses: int
        +WinRate: double
        +MatchesPlayed: int
        +DisplayName: string
    }
    
    class SeasonMessage {
        +ChannelId: ulong
        +MessageId: ulong
        +Type: SeasonMessageType
        +Timestamp: DateTimeOffset
    }
    
    ' Enum for Season Message Types
    enum SeasonMessageType {
        Announcement
        Update
        Ranking
        Event
    }
    
    ' Team model for player teams
    class RatingTeam {
        +TeamId: string
        +TeamName: string
        +GameType: TeamGameType
        +Rating: int
        +TournamentRating: int
        +CreatedAt: DateTimeOffset
        +CorePlayers: List<DiscordUser>
        +SecondaryPlayers: List<DiscordUser>
        +SubstitutePlayers: List<DiscordUser>
        +Wins: int
        +Losses: int
        +WinRate: double
        +RatingHistory: List<RatingChange>
        +Creator: DiscordUser
        +AddCorePlayer()
        +AddSecondaryPlayer()
        +AddSubstitutePlayer()
        +ChangeName()
        +UpdateRating()
        +UpdateTournamentRating()
        +HasRequiredPlayers()
        +HasPlayer()
        +HasPlayerInRole()
        +GetPlayerCounts()
    }
    
    class RatingChange {
        +OldRating: int
        +NewRating: int
        +Change: int
        +Opponent: string
        +IsWin: bool
        +IsTournamentMatch: bool
        +TournamentName: string
        +Date: DateTimeOffset
    }
    
    class PlayerInfo {
        +Id: ulong
        +Username: string
    }
    
    enum PlayerRole {
        Core
        Secondary
        Substitute
    }
    
    ' Scrimmage model
    class Scrimmage {
        +Thread: DiscordThreadChannel
        +GameType: ScrimmageGameType
        +TeamA: ScrimmageTeam
        +TeamB: ScrimmageTeam
        +Maps: List<string>
        +Status: ScrimmageStatus
        +Messages: List<DiscordMessage>
        +StatusMessage: DiscordMessage?
        +MatchLength: MatchLength
        +IsRated: bool
        +UseTournamentMapPool: bool
        +CurrentGameNumber: int
        +TeamAScore: int
        +TeamBScore: int
        +CreatedAt: DateTimeOffset
        +CompletedAt: DateTimeOffset?
        +Results: List<int>
        +TeamAMapBans: List<string>
        +TeamBMapBans: List<string>
    }
    
    class ScrimmageTeam {
        +TeamId: string?
        +TeamName: string?
        +Captain: DiscordUser
        +Members: List<DiscordUser>
        +DeckCodes: Dictionary<ulong, string>
        +DeckName: string?
        +DisplayName: string
        +SetDeckCode()
        +GetDeckCode()
        +AllPlayersHaveSubmittedDeckCodes()
    }
    
    enum ScrimmageStatus {
        Created
        InProgress
        Completed
        Cancelled
    }
    
    enum MatchLength {
        Bo1
        Bo3
        Bo5
    }
    
    ' Base and Generated Game Type enums
    class GameType <<enum>> {
        OneVOne
        TwoVTwo
        ThreeVThree
        FourVFour
    }
    
    class TeamGameType <<generated>> {
        OneVOne
        TwoVTwo
        ThreeVThree
        FourVFour
    }
    
    class ScrimmageGameType <<generated>> {
        OneVOne
        TwoVTwo
        ThreeVThree
        FourVFour
    }
    
    class TournamentGameType <<generated>> {
        OneVOne
        TwoVTwo
        ThreeVThree
        FourVFour
    }
    
    class SignupGameType <<generated>> {
        OneVOne
        TwoVTwo
        ThreeVThree
        FourVFour
    }
    
    ' Enums
    enum TournamentStage {
        SignupOpen
        Groups
        Playoffs
        Complete
    }
    
    enum TournamentFormat {
        GroupStageWithPlayoffs
        SingleElimination
        DoubleElimination
        RoundRobin
    }
    
    enum TournamentMatchType {
        GroupStage
        GroupStageTiebreaker
        RoundOf16
        Quarterfinal
        Semifinal
        Final
        PlayoffThirdPlace
    }
    
    enum MatchStatus {
        Pending
        InProgress
        Completed
        Cancelled
    }
    
    enum MatchResultType {
        Normal
        Forfeit
        Disqualification
        Tiebreaker
        Default
    }
    
    enum MatchStage {
        Created
        MapBan
        DeckSubmission
        DeckRevision
        GameResults
        Completed
    }
    
    ' Model relationships
    Tournament *-- "0..*" Group
    Tournament *-- "0..*" Match
    Tournament *-- "1" TournamentSettings
    
    Group *-- "0..*" GroupParticipant
    Group *-- "0..*" Match
    Group --o "1" Tournament
    
    Match *-- "0..*" MatchParticipant
    Match *-- "0..1" MatchResult
    Match --o "0..1" Match : NextMatch
    Match --o "0..1" Match : ThirdPlaceMatch
    Match --o "0..1" Round
    
    MatchParticipant --o "0..1" Group
    MatchParticipant --o "0..1" Match
    
    Round *-- "0..*" Team
    Team *-- "0..*" Participant
    
    TournamentSignup *-- "0..*" ParticipantSeed
    TournamentSignup *-- "0..*" RelatedMessage
    
    ' Rating system relationships
    Season *-- "0..*" SeasonRanking
    Season *-- "0..*" SeasonMessage
    
    RatingTeam *-- "0..*" RatingChange
    RatingTeam *-- "0..*" PlayerInfo
    
    ' Scrimmage relationships
    Scrimmage *-- "1" ScrimmageTeam : TeamA
    Scrimmage *-- "1" ScrimmageTeam : TeamB
    ScrimmageTeam --o "0..1" RatingTeam : LinkedTeam
    
    ' Utility class for GameType extensions
    class GameTypeExtensions <<static>> {
        +ToDisplayString<T>(gameType: T): string
    }
}

' Define new package for Event Handling System
package "Event Handling System" as EventLayer {
    ' Main event handlers
    class ComponentInteractionHandler <<event handler>> {
        -_factory: ComponentHandlerFactory
        -_logger: ILogger
        +HandleEventAsync(sender: DiscordClient, e: ComponentInteractionCreatedEventArgs)
    }

    class ModalInteractionHandler <<event handler>> {
        -_factory: ModalHandlerFactory
        -_logger: ILogger
        +HandleEventAsync(sender: DiscordClient, e: ModalSubmitEventArgs)
    }

    ' Component handlers
    class TournamentSignupHandler <<component handler>> {
        -_signupService: ITournamentSignupService
        -_tournamentService: ITournamentService
        +CanHandle(customId: string): bool
        +HandleAsync(client: DiscordClient, e: ComponentInteractionCreatedEventArgs, hasBeenDeferred: bool): Task
        -HandleSignupButton()
        -HandleWithdrawButton()
        -HandleCancelSignupButton()
    }

    class MapBanHandler <<component handler>> {
        -_matchStatusService: IMatchStatusService
        -_mapService: ITournamentMapService
        +CanHandle(customId: string): bool
        +HandleAsync(client: DiscordClient, e: ComponentInteractionCreatedEventArgs, hasBeenDeferred: bool): Task
    }

    class GameResultHandler <<component handler>> {
        -_gameService: ITournamentGameService
        +CanHandle(customId: string): bool
        +HandleAsync(client: DiscordClient, e: ComponentInteractionCreatedEventArgs, hasBeenDeferred: bool): Task
    }

    class DeckSubmissionHandler <<component handler>> {
        -_matchStatusService: IMatchStatusService
        +CanHandle(customId: string): bool
        +HandleAsync(client: DiscordClient, e: ComponentInteractionCreatedEventArgs, hasBeenDeferred: bool): Task
    }
    
    class SeasonHandler <<component handler>> {
        -_seasonService: ISeasonService
        +CanHandle(customId: string): bool
        +HandleAsync(client: DiscordClient, e: ComponentInteractionCreatedEventArgs, hasBeenDeferred: bool): Task
    }
    
    class ScrimmageComponentHandler <<component handler>> {
        -_scrimmageService: IScrimmageService
        -_scrimmageStatusService: IScrimmageStatusService
        +CanHandle(customId: string): bool
        +HandleAsync(client: DiscordClient, e: ComponentInteractionCreatedEventArgs, hasBeenDeferred: bool): Task
    }

    class LeaderboardHandler <<component handler>> {
        -_leaderboardService: ILeaderboardService
        -_seasonStateService: ISeasonStateService
        +CanHandle(customId: string): bool
        +HandleAsync(client: DiscordClient, e: ComponentInteractionCreatedEventArgs, hasBeenDeferred: bool): Task
        -HandleGameTypeChange()
        -HandlePageNavigation()
        -HandleSeasonChange()
    }

    class RefreshStatusHandler <<component handler>> {
        -_roundsHolder: OngoingRounds
        -_matchStatusService: IMatchStatusService
        +CanHandle(customId: string): bool
        +HandleAsync(client: DiscordClient, e: ComponentInteractionCreatedEventArgs, hasBeenDeferred: bool): Task
    }

    ' Modal handlers
    class MapBanModalHandler <<modal handler>> {
        -_matchStatusService: IMatchStatusService
        -_mapService: ITournamentMapService
        +CanHandle(customId: string): bool
        +HandleAsync(client: DiscordClient, e: ModalSubmitEventArgs, hasBeenDeferred: bool): Task
    }

    class DeckSubmissionModalHandler <<modal handler>> {
        -_matchStatusService: IMatchStatusService
        +CanHandle(customId: string): bool
        +HandleAsync(client: DiscordClient, e: ModalSubmitEventArgs, hasBeenDeferred: bool): Task
    }

    class TournamentCreationModalHandler <<modal handler>> {
        -_tournamentService: ITournamentService
        -_managerService: ITournamentManagerService
        +CanHandle(customId: string): bool
        +HandleAsync(client: DiscordClient, e: ModalSubmitEventArgs, hasBeenDeferred: bool): Task
    }
    
    class ScrimmageCreationModalHandler <<modal handler>> {
        -_scrimmageService: IScrimmageService
        +CanHandle(customId: string): bool
        +HandleAsync(client: DiscordClient, e: ModalSubmitEventArgs, hasBeenDeferred: bool): Task
    }
    
    class TeamCreationModalHandler <<modal handler>> {
        -_teamService: ITeamService
        +CanHandle(customId: string): bool
        +HandleAsync(client: DiscordClient, e: ModalSubmitEventArgs, hasBeenDeferred: bool): Task
    }

    ' Factories
    class ComponentHandlerFactory <<factory>> {
        -_serviceProvider: IServiceProvider
        -_logger: ILogger
        +CreateHandler(customId: string): ComponentHandlerBase
    }

    class ModalHandlerFactory <<factory>> {
        -_serviceProvider: IServiceProvider
        -_logger: ILogger
        +CreateHandler(customId: string): ModalHandlerBase
    }

    ' Base abstract classes
    abstract class ComponentHandlerBase {
        #_logger: ILogger
        #_stateService: ITournamentStateService
        +{abstract} CanHandle(customId: string): bool
        +{abstract} HandleAsync(client: DiscordClient, e: ComponentInteractionCreatedEventArgs, hasBeenDeferred: bool): Task
    }

    abstract class ModalHandlerBase {
        #_logger: ILogger
        #_stateService: ITournamentStateService
        +{abstract} CanHandle(customId: string): bool
        +{abstract} HandleAsync(client: DiscordClient, e: ModalSubmitEventArgs, hasBeenDeferred: bool): Task
    }
}

' Define service layers as packages
package "Command/UI Layer" as UILayer {
    class TournamentManagementGroup <<command handler>> {
        +TManagementBasicGroup 
        +TManagementSignupGroup
        +TManagementRecoveryGroup
    }

    class TManagementBasicGroup <<partial>> {
        +CreateTournamentFromSignup()
        +ShowStandings()
        +ListTournaments()
        +DeleteTournament()
        +ResumeTournament()
        +RepairData()
        +SaveTournamentData()
        +SetStandingsChannel()
        +HandleMatchCompletion()
        +HandleGameResultAsync()
        +StartGroupStageMatches()
    }

    class TManagementSignupGroup <<partial>> {
        +CreateSignup() <<"/tournament signup_create">>
        +CloseSignup() <<"/tournament signup_close">>
        +ReopenSignup() <<"/tournament signup_reopen">>
        +AddToSignup() <<"/tournament signup_add">>
        +RemoveFromSignup() <<"/tournament signup_remove">>
        +SetSeed() <<"/tournament signup_set_seed">>
        +SetTournamentSeed() <<"/tournament set_tournament_seed">>
        -UpdateSignupMessage()
    }

    class TManagementRecoveryGroup <<partial>> {
        +RecoverThreads() <<"/tournament recover_threads">>
        +RecoverPlayerThread() <<"/tournament recover_player_thread">>
        +RecoverMatch() <<"/tournament recover_match">>
        +RebuildTournament() <<"/tournament rebuild_tournament">>
        +ValidateTournament() <<"/tournament validate_tournament">>
    }
    
    class AdminThirdPlaceMatchHandler <<component handler>> {
        +HandleAdminThirdPlaceMatchAsync()
    }
    
    class "Map/Game Handlers" as GameHandlers <<component handler>> {
        +MapBanHandler
        +GameResultHandler
    }
    
    class TeamGroup <<command handler>> {
        -_teamService: ITeamService
        -_seasonStateService: ISeasonStateService
        -_leaderboardService: ILeaderboardService
        +RegisterForSoloAsync()
        +CreateTeamAsync()
        +JoinTeamAsync()
        +LeaveTeamAsync()
        +ShowTeamAsync()
        +ListTeamsAsync()
        +RenameTeamAsync()
        +AddPlayerAsync()
        +RemovePlayerAsync()
        +MyStatsAsync()
    }
    
    class TeamManagementGroup <<command handler>> {
        -_logger: ILogger<TeamManagementGroup>
        -_teamService: ITeamService
        -_seasonStateService: ISeasonStateService
        -_leaderboardService: ILeaderboardService
        +ForceCreateTeamAsync() <<"/team-admin force_create">>
        +DeleteTeamAsync() <<"/team-admin delete">>
        +AddPlayerToTeamAsync() <<"/team-admin add_player">>
        +RemovePlayerFromTeamAsync() <<"/team-admin remove_player">>
        +ResetTeamRatingAsync() <<"/team-admin reset_rating">>
        +ListTeamsAsync() <<"/team-admin list">>
    }
    
    class SeasonGroup <<command handler>> {
        +CreateSeason() <<"/season create">>
        +EndSeason() <<"/season end">>
        +ShowSeason() <<"/season show">>
        +ListSeasons() <<"/season list">>
        +SetCurrentSeason() <<"/season set_current">>
    }
    
    class ScrimmageGroup <<command handler>> {
        +CreateScrimmage() <<"/scrimmage create">>
        +StartScrimmage() <<"/scrimmage start">>
        +CancelScrimmage() <<"/scrimmage cancel">>
        +ReportWin() <<"/scrimmage win">>
        +SetDeck() <<"/scrimmage set_deck">>
    }
    
    note right of TManagementSignupGroup::CreateSignup
      /tournament signup_create <n> <format> <gameType> <startTimeUnix>
      Creates tournament signup with specified parameters
    end note
    
    note right of TManagementRecoveryGroup::RecoverThreads
      /tournament recover_threads <tournamentName>
      Recovers threads and match status embeds for a tournament
    end note
    
    note right of TeamGroup::CreateTeam
      /team create <name> <gameType>
      Creates a new team with the specified name and game type
    end note
    
    note right of ScrimmageGroup::CreateScrimmage
      /scrimmage create <opponent> <bestOf> <isRated>
      Creates a new scrimmage against the specified opponent
    end note
}

